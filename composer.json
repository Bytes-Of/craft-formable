{
  "name": "bytesof/craft-formable",
  "description": "Accessible multi-page forms with conditional logic, GDPR tools and integrations.",
  "type": "craft-plugin",
  "license": "proprietary",
  "homepage": "https://github.com/Bytes-Of/craft-formable",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "keywords": [
    "craftcms",
    "craft-plugin",
    "forms",
    "form builder",
    "contact form",
    "multi-page forms",
    "conditional logic",
    "accessibility",
    "wcag",
    "gdpr",
    "spam protection",
    "hubspot",
    "mailchimp",
    "slack",
    "webhooks",
    "graphql"
  ],
  "support": {
    "docs": "https://github.com/Bytes-Of/craft-formable/tree/main/docs",
    "issues": "https://github.com/Bytes-Of/craft-formable/issues",
    "source": "https://github.com/Bytes-Of/craft-formable",
    "email": "munteanumariaviviana@gmail.com"
  },
  "authors": [
    {
      "name": "Maria Viviana MUNTEANU",
      "email": "munteanumariaviviana@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.10.7"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "symplify/easy-coding-standard": "^12",
    "pestphp/pest": "^3.0",
    "mockery/mockery": "^1.6",
    "squizlabs/php_codesniffer": "^3.9"
  },
  "autoload": {
    "psr-4": {
      "bytesof\\formable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "bytesof\\formable\\tests\\": "tests/",
      "bytesof\\formable\\ecs\\": "ecs/"
    },
    "files": [
      "vendor/squizlabs/php_codesniffer/autoload.php"
    ]
  },
  "extra": {
    "class": "bytesof\\formable\\Plugin",
    "handle": "formable",
    "name": "Formable",
    "developer": "Bytes Of",
    "developerUrl": "https://github.com/Bytes-Of",
    "developerEmail": "munteanumariaviviana@gmail.com",
    "documentationUrl": "https://github.com/Bytes-Of/craft-formable/tree/main/docs",
    "changelogUrl": "https://raw.githubusercontent.com/Bytes-Of/craft-formable/main/CHANGELOG.md",
    "editions": [
      {
        "name": "Lite",
        "handle": "lite"
      },
      {
        "name": "Pro",
        "handle": "pro"
      }
    ]
  },
  "scripts": {
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist",
    "ecs": "ecs check --ansi",
    "ecs-fix": "ecs check --ansi --fix",
    "test": "pest",
    "test:watch": "pest --watch",
    "test:db": "scripts/test-db.sh",
    "test:functional": "pest --configuration=phpunit.functional.xml",
    "test:all": ["@test", "@test:functional"]
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true
    }
  }
}
