{% import '_includes/forms' as forms %}
{% import 'formable/_includes/upgradeBadge' as upgrade %}
{{ upgrade.styles() }}

{# Editions / license
 #
 # Craft manages plugin license keys itself (via the Plugin Store and the
 # licence-key field it renders around this settings page), so this section is
 # purely informational: the active edition, what each edition includes, and a
 # call-to-action into the Plugin Store. The upgrade prompts elsewhere in the CP
 # deep-link to the `#formable-editions` anchor below.
 #}
{% set proFeatures = [
    'Conditional logic (show/hide fields and pages by answer)'|t('formable'),
    'Scheduled forms & submission limits'|t('formable'),
    'Save & resume partially-completed submissions'|t('formable'),
    'Launch integrations - Slack, Mailchimp, HubSpot, Webhook'|t('formable'),
    'Captchas - reCAPTCHA, hCaptcha, Turnstile'|t('formable'),
    'Automatic data-retention purging'|t('formable'),
    'Weekly digest emails'|t('formable'),
    'Submission edit history'|t('formable'),
    'Front-end member submissions & the GraphQL API'|t('formable'),
] %}
{% set liteFeatures = [
    'Unlimited forms, fields & multi-page layouts'|t('formable'),
    'Email notifications with conditions'|t('formable'),
    'Spam protection - honeypot, keywords, IP blocking'|t('formable'),
    'File uploads & submission management'|t('formable'),
    'CSV / JSON export & import'|t('formable'),
] %}

<div id="formable-editions" class="formable-editions">
    <div class="formable-editions__header">
        <div>
            <h2>{{ 'Edition'|t('formable') }}</h2>
            <p class="formable-editions__active">
                {{ 'You are running'|t('formable') }}
                <strong>{{ isPro ? 'Formable Pro'|t('formable') : 'Formable Lite'|t('formable') }}</strong>.
                {% if isPro %}
                    {{ 'Every Pro feature below is unlocked.'|t('formable') }}
                {% else %}
                    {{ 'Upgrade to Pro to unlock the features on the right.'|t('formable') }}
                {% endif %}
            </p>
        </div>
        <div class="formable-editions__cta">
            {% if isPro %}
                <a class="btn" href="{{ url('plugin-store/formable') }}">{{ 'Manage license'|t('formable') }}</a>
            {% else %}
                <a class="btn submit" href="{{ url('plugin-store/formable') }}">{{ 'Buy Formable Pro'|t('formable') }}</a>
            {% endif %}
        </div>
    </div>

    <div class="formable-editions__grid">
        <div class="formable-editions__col{{ not isPro ? ' formable-editions__col--active' : '' }}">
            <h3>{{ 'Lite'|t('formable') }}{% if not isPro %} <span class="formable-editions__you">{{ 'Your edition'|t('formable') }}</span>{% endif %}</h3>
            <ul>
                {% for feature in liteFeatures %}
                    <li>{{ feature }}</li>
                {% endfor %}
            </ul>
        </div>
        <div class="formable-editions__col{{ isPro ? ' formable-editions__col--active' : '' }}">
            <h3>{{ 'Pro'|t('formable') }} {{ upgrade.badge() }}{% if isPro %} <span class="formable-editions__you">{{ 'Your edition'|t('formable') }}</span>{% endif %}</h3>
            <p class="formable-editions__col-lead">{{ 'Everything in Lite, plus:'|t('formable') }}</p>
            <ul>
                {% for feature in proFeatures %}
                    <li>{{ feature }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>

{% css %}
    .formable-editions {
        border: 1px solid var(--hairline-color, #e3e5e8);
        border-radius: 6px;
        padding: 18px 20px;
        margin-bottom: 24px;
        background: var(--gray-050, #f9fafc);
    }
    .formable-editions__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }
    .formable-editions__header h2 {
        margin: 0 0 4px;
    }
    .formable-editions__active {
        margin: 0;
        color: var(--medium-text-color, #606d7b);
    }
    .formable-editions__cta {
        flex-shrink: 0;
    }
    .formable-editions__grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-top: 18px;
    }
    @media (max-width: 640px) {
        .formable-editions__grid {
            grid-template-columns: 1fr;
        }
    }
    .formable-editions__col {
        border: 1px solid var(--hairline-color, #e3e5e8);
        border-radius: 5px;
        padding: 14px 16px;
        background: var(--white, #fff);
    }
    .formable-editions__col--active {
        border-color: var(--enabled-color, #27ae60);
        box-shadow: 0 0 0 1px var(--enabled-color, #27ae60);
    }
    .formable-editions__col h3 {
        margin: 0 0 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .formable-editions__col-lead {
        margin: 0 0 8px;
        color: var(--medium-text-color, #606d7b);
        font-size: 12px;
    }
    .formable-editions__you {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: var(--enabled-color, #27ae60);
    }
    .formable-editions__col ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .formable-editions__col li {
        position: relative;
        padding: 3px 0 3px 22px;
        font-size: 13px;
    }
    .formable-editions__col li::before {
        content: '✓';
        position: absolute;
        left: 0;
        top: 3px;
        color: var(--enabled-color, #27ae60);
        font-weight: 700;
    }
{% endcss %}

