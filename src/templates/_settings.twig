{% js %}
(function() {
    var btn = document.getElementById('formable-digest-test-btn');
    if (!btn) return;
    var spinner = document.getElementById('formable-digest-test-spinner');
    btn.addEventListener('click', function() {
        var to = document.getElementById('formable-digest-test-to').value;
        btn.classList.add('disabled');
        btn.setAttribute('disabled', 'disabled');
        spinner.classList.remove('hidden');
        Craft.sendActionRequest('POST', 'formable/digest/test', { data: { to: to } })
            .then(function(response) {
                var data = response.data || {};
                if (data.success) {
                    Craft.cp.displayNotice(Craft.escapeHtml(data.message));
                } else {
                    Craft.cp.displayError(Craft.escapeHtml(data.message));
                }
            })
            .catch(function(e) {
                var msg = (e.response && e.response.data && e.response.data.message)
                    ? e.response.data.message
                    : Craft.t('formable', 'The test digest could not be sent.');
                Craft.cp.displayError(Craft.escapeHtml(msg));
            })
            .finally(function() {
                btn.classList.remove('disabled');
                btn.removeAttribute('disabled');
                spinner.classList.add('hidden');
            });
    });
})();
{% endjs %}

