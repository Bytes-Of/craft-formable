    </div>
    <div class="input">
        <input type="text" class="text" id="formable-digest-test-to" placeholder="you@example.com" style="max-width:260px;display:inline-block;">
        <button type="button" class="btn" id="formable-digest-test-btn">{{ 'Send test digest'|t('formable') }}</button>
        <span class="spinner hidden" id="formable-digest-test-spinner"></span>
    </div>
</div>
