{% js %}
(function() {
    var ids = {
        brand: '{{ 'palette-brand'|namespaceInputId }}',
        surface: '{{ 'palette-surface'|namespaceInputId }}',
        text: '{{ 'palette-text'|namespaceInputId }}',
        border: '{{ 'palette-border'|namespaceInputId }}'
    };
    var output = document.getElementById('{{ 'formable-palette-contrast'|namespaceInputId }}');
    if (!output) {
        return;
    }

    var pairs = [
        { a: 'text', b: 'surface', threshold: 4.5, label: Craft.t('formable', 'Text on surface') },
        { a: 'border', b: 'surface', threshold: 3, label: Craft.t('formable', 'Border on surface') },
        { a: 'brand', b: 'surface', threshold: 3, label: Craft.t('formable', 'Brand on surface') }
    ];

    function isHex(value) {
        return /^[0-9a-f]{6}$/i.test((value || '').replace('#', ''));
    }

    function relativeLuminance(hex) {
        hex = hex.replace('#', '');
        var channels = [
            parseInt(hex.substr(0, 2), 16) / 255,
            parseInt(hex.substr(2, 2), 16) / 255,
            parseInt(hex.substr(4, 2), 16) / 255
        ].map(function(normalized) {
            return normalized <= 0.03928 ? normalized / 12.92 : Math.pow((normalized + 0.055) / 1.055, 2.4);
        });

        return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
    }

    function contrastRatio(hexA, hexB) {
        var a = relativeLuminance(hexA);
        var b = relativeLuminance(hexB);

        return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
    }

    function render() {
        var values = {};

        Object.keys(ids).forEach(function(key) {
            var el = document.getElementById(ids[key]);
            values[key] = el ? el.value : '';
        });

        output.innerHTML = pairs
            .filter(function(pair) {
                return isHex(values[pair.a]) && isHex(values[pair.b]);
            })
            .map(function(pair) {
                var ratio = contrastRatio(values[pair.a], values[pair.b]);
                var passes = ratio >= pair.threshold;

                return '<p style="color:' + (passes ? 'var(--enabled-color, #27ae60)' : 'var(--error-color, #cf1124)') + ';margin:2px 0;">'
                    + Craft.escapeHtml(pair.label) + ': ' + ratio.toFixed(2) + ':1'
                    + ' (' + pair.threshold.toFixed(1) + ':1 needed) '
                    + (passes ? '✓' : '✗')
                    + '</p>';
            })
            .join('');
    }

    Object.keys(ids).forEach(function(key) {
        var el = document.getElementById(ids[key]);
        if (el) {
            el.addEventListener('input', render);
        }
    });

    render();
})();
{% endjs %}

