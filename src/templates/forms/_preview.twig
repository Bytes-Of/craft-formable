{#
 # The author-facing preview: the builder's current working layout, rendered
 # as a bare standalone document. Unlike the devMode QA gallery
 # (`preview/_frame.twig`), this carries no host/chrome/width fixtures - it
 # exists to show what the form actually looks like, not to stress-test it.
 #
 # A form's own real Submit (and, on a multi-page form, Next/Back) is
 # intercepted below rather than left to hit the live submit/page-flow
 # actions: the form rendered here was saved and rolled back within the
 # request that produced this page, so by the time a visitor clicks anything
 # it no longer exists to resolve against. Paging between pages instead goes
 # through the plain `<form>` beneath the preview, which re-posts the same
 # layout to this same action with a different `page` - a full request each
 # time, but one that works with JavaScript off, matching the rest of the
 # plugin's degrade-without-JS posture.
 #
 # Variables:
 #   form              the transient, unsaved Form element
 #   page              the page index being shown
 #   pageCount         total pages in the layout
 #   pagesJson         the normalized pages array, JSON-encoded, for the pager
 #   settingsJson      the normalized settings array, JSON-encoded, for the pager
 #   translationsJson  the posted translations blob, JSON-encoded, for the pager
 #   currentSiteUid    the site this render actually used - the posted `siteUid`
 #                      when Pro and one was given, the CP's own current site
 #                      otherwise
 #}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ form.title }} · {{ 'Preview'|t('formable') }}</title>
    {{ head() }}
    <style>
        body {
            margin: 0;
            padding: 2rem;
            background: var(--formable-surface-raised, #f4f4f5);
        }
        .formable-author-preview {
            max-width: 40rem;
            margin-inline: auto;
        }
        .formable-author-preview__banner {
            margin-block-end: 1.5rem;
            padding: 0.75rem 1rem;
            border-radius: 0.375rem;
            border: 1px solid #a1a1aa;
            background: #fff;
            font: 0.875rem/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: #3f3f46;
        }
        .formable-author-preview__pager {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-block-start: 1.5rem;
        }
        .formable-author-preview__pager button {
            font: inherit;
            padding: 0.375rem 0.75rem;
            border-radius: 0.375rem;
            border: 1px solid #a1a1aa;
            background: #fff;
            cursor: pointer;
        }
        .formable-author-preview__pager button[aria-current="page"] {
            background: #3f3f46;
            border-color: #3f3f46;
            color: #fff;
        }
        .formable-author-preview__site {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font: 0.875rem/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: #3f3f46;
        }
        .formable-author-preview__site select {
            font: inherit;
            padding: 0.375rem 0.75rem;
            border-radius: 0.375rem;
            border: 1px solid #a1a1aa;
            background: #fff;
        }
    </style>
</head>
<body>
    {{ beginBody() }}
    <div class="formable-author-preview">
        <p class="formable-author-preview__banner" role="status" data-preview-banner>
            {{ 'Previewing your unsaved layout. Nothing you submit here is saved.'|t('formable') }}
        </p>

        <div data-preview-target>
            {{ craft.formable.renderForm(form, { page: page }) }}
        </div>

        {% set sites = craft.formable.isPro ? craft.app.sites.getAllSites() : [] %}
        {% if pageCount > 1 or sites|length > 1 %}
            <form
                method="post"
                action="{{ actionUrl('formable/forms/preview') }}"
                class="formable-author-preview__pager"
                aria-label="{{ 'Preview options'|t('formable') }}"
            >
                {{ csrfInput() }}
                <input type="hidden" name="title" value="{{ form.title }}">
                <input type="hidden" name="pages" value="{{ pagesJson|e('html_attr') }}">
                <input type="hidden" name="settings" value="{{ settingsJson|e('html_attr') }}">
                <input type="hidden" name="translations" value="{{ translationsJson|e('html_attr') }}">
                {% if sites|length > 1 %}
                    {# A site switch re-posts the whole preview, so an override on
                       that site shows up before the layout is ever saved - the
                       same reason the pager below is a full re-post rather than
                       client-side paging. #}
                    <label class="formable-author-preview__site">
                        {{ 'Site'|t('formable') }}
                        <select name="siteUid" onchange="this.form.submit()">
                            {% for site in sites %}
                                <option value="{{ site.uid }}" {% if site.uid == currentSiteUid %}selected{% endif %}>{{ site.name }}</option>
                            {% endfor %}
                        </select>
                    </label>
                {% endif %}
                {% for i in 0..(pageCount - 1) %}
                    <button
                        type="submit"
                        name="page"
                        value="{{ i }}"
                        {% if i == page %}aria-current="page"{% endif %}
                    >
                        {{ 'Page {number}'|t('formable', { number: i + 1 }) }}
                    </button>
                {% endfor %}
            </form>
        {% endif %}
    </div>
    <script>
        (function () {
            var target = document.querySelector('[data-preview-target]');
            var banner = document.querySelector('[data-preview-banner]');

            if (!target || !banner) {
                return;
            }

            document.addEventListener('submit', function (event) {
                if (!target.contains(event.target)) {
                    return;
                }

                event.preventDefault();
                event.stopImmediatePropagation();
                banner.textContent = {{ 'Preview only. This submission was not sent.'|t('formable')|json_encode|raw }};
            }, true);
        })();
    </script>
    {{ endBody() }}
</body>
</html>
