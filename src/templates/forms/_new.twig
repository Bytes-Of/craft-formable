{% extends '_layouts/cp' %}

{% set crumbs = [
    { label: 'Formable'|t('formable'), url: cpUrl('formable') },
    { label: 'Forms'|t('formable'), url: cpUrl('formable/forms') },
] %}

{% block content %}
    <p class="light">{{ 'Pick a starting point. You can change everything once the builder opens.'|t('formable') }}</p>

    <ul class="formable-presets">
        {% for preset in presets %}
            <li>
                <a class="formable-preset" href="{{ url(createUrl, { preset: preset.handle }) }}">
                    <span class="formable-preset__name">{{ preset.name }}</span>
                    <span class="formable-preset__desc light">{{ preset.description }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}

{% css %}
    .formable-presets {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 14px;
        margin-top: 18px;
        padding: 0;
        list-style: none;
    }
    .formable-preset {
        display: flex;
        flex-direction: column;
        gap: 6px;
        height: 100%;
        padding: 16px;
        border: 1px solid var(--hairline-color, #dbdfe3);
        border-radius: 6px;
        background: var(--white, #fff);
        color: inherit;
        text-decoration: none;
        transition: border-color .1s ease, box-shadow .1s ease;
    }
    .formable-preset:hover,
    .formable-preset:focus {
        border-color: var(--link-color, #1f6fdd);
        box-shadow: 0 1px 4px rgba(0, 0, 0, .08);
        text-decoration: none;
    }
    .formable-preset__name {
        font-weight: 600;
    }
{% endcss %}
